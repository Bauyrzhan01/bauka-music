{
  "name": "bauka-music",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "music:scan": "node scripts/scan-music.js",
    "verify": "node scripts/verify-features.js",
    "icon:apply": "node scripts/apply-app-icon.js",
    "urls": "node scripts/print-urls.js",
    "server": "node scripts/start-server.js",
    "expo": "expo start --host lan",
    "expo:tunnel": "expo start --tunnel",
    "start": "node scripts/dev.js",
    "start:clean": "node scripts/dev.js --clear",
    "start:tunnel": "node scripts/dev.js --tunnel",
    "prestart": "npm run music:scan",
    "android": "expo run:android",
    "android:check": "node scripts/check-android-device.js",
    "android:usb": "node scripts/install-android-usb.js",
    "android:usb:debug": "node scripts/install-android-usb.js --debug",
    "ios": "expo run:ios",
    "ios:eas": "node scripts/install-ios-eas.js",
    "web": "node scripts/dev.js --web",
    "preweb": "npm run music:scan",
    "apk:setup": "node scripts/resolve-build-api-url-cli.js",
    "apk:cloud": "node scripts/build-apk.js",
    "apk": "npm run apk:cloud",
    "build:production": "eas workflow:run create-production-builds.yml",
    "build:all": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.34",
    "expo-audio": "~1.1.1",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "private": true,
  "overrides": {
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "eas-cli": "^20.0.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "sharp": "^0.34.5"
  }
}
