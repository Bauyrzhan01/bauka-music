# API для телефона и APK (IP ноутбука в Wi‑Fi или публичный сервер)
# npm run apk:setup — подставит IP автоматически в .env
# EXPO_PUBLIC_API_URL=http://192.168.0.105:3001

# Публичная ссылка для QR скачивания приложения (npm run qr:app)
# PUBLIC_APP_URL=https://ваш-домен или npm run app:share — туннель автоматически

# Сборка APK (тест на телефоне): npm run apk
# Production Android + iOS: npm run build:production
# Или: npm run build:all
# Сборки: https://expo.dev/accounts/bauka006/projects/bauka-music/builds

# Google Gemini — ИИ-синхронизация караоке (ключ: https://aistudio.google.com/apikey)
# Скопируйте в .env (файл .env не коммитьте в git)
GEMINI_API_KEY=

# Модель. При ошибке квоты попробуйте gemini-2.5-flash или gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash
